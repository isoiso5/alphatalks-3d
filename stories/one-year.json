   ],
   "time": "night",
   "tone": "cold",
   "punch": "He stopped believing he was worth it."
  },
  {
   "env": "room",
   "durationSec": 4,
   "caption": "Zara noticed first. She noticed him out of breath on the stairs. She noticed he stopped playing with his nephews in the yard.",
